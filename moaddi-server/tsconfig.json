{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "Node16",
    "moduleResolution": "Node16",

    /* Allow mixing JS and TS */
    "allowJs": true,
    "checkJs": false,

    /* Strict-ish — enable gradually as you migrate files */
    "strict": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    /* No output — tsx handles running, tsc is only for type-checking */
    "noEmit": true,

    /* Source maps for readable stack traces in tsx */
    "sourceMap": true,

    /* Skip type-checking third-party libs that have no types */
    "skipLibCheck": true
  },
  "include": [
    "index.js",
    "config/**/*",
    "app/**/*",
    "db/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
