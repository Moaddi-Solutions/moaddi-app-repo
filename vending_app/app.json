{
  "expo": {
    "name": "Moaddi",
    "slug": "moaddi-app",
    "version": "4.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.jpg",
    "scheme": "moaddi",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon-new.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moaddi",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "We use Bluetooth to connect to vending locks.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "buildNumber": "7",
      "associatedDomains": [
        "applinks:server.moaddi-app.com",
        "applinks:moaddi-app.com",
        "applinks:www.moaddi-app.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-new.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.moaddi",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "server.moaddi-app.com",
              "pathPrefix": "/gift"
            },
            {
              "scheme": "https",
              "host": "moaddi-app.com",
              "pathPrefix": "/gift"
            },
            {
              "scheme": "https",
              "host": "www.moaddi-app.com",
              "pathPrefix": "/gift"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-new.jpg"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Connecting to the vending machine requires Bluetooth access, which allows $(PRODUCT_NAME) to send commands and process your purchase."
        }
      ],
      "expo-localization",
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.779636724237-ka2k6s87pglg66rmiqv8gehjru9kevf3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "$(PRODUCT_NAME) use your camera to scan the QR codes on our vending machines to facilitate your purchase.",
          "microphonePermission": "$(PRODUCT_NAME) use your camera to scan the QR codes on our vending machines to facilitate your purchase.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true
          },
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [],
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d21a7b3f-c67d-4971-aa87-b828fc5bec6c"
      }
    },
    "runtimeVersion": "4.3.0",
    "owner": "moaddiexpo"
  }
}
