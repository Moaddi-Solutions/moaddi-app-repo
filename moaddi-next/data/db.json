        {
          "type": "paragraph",
          "children": [
            {
              "text": "Our office is located in Valley Village and we welcome patients from the greater Los Angeles area. To experience compassionate and exceptional care, call us today at ",
              "type": "text"
            },
            {
              "url": "tel:1-818-763-8999",
              "type": "link",
